{
  "name": "mep-actas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:local": "pnpm db:init-local && TURSO_DATABASE_URL=file:./mep-actas-local.db next dev",
    "dev:local:demo": "pnpm db:init-local && pnpm db:seed-demo && TURSO_DATABASE_URL=file:./mep-actas-local.db next dev",
    "db:init-local": "tsx scripts/init-local-db.ts",
    "db:seed-demo": "tsx scripts/seed-datos-demo.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.mts",
    "verify:fast": "pnpm lint && pnpm typecheck && pnpm test",
    "verify": "pnpm verify:fast && pnpm test:e2e",
    "verify:ci": "pnpm lint && pnpm typecheck && pnpm test -- --reporter=verbose && pnpm build && pnpm test:e2e -- --reporter=verbose"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1075.0",
    "@aws-sdk/s3-request-presigner": "^3.1075.0",
    "@libsql/client": "^0.17.4",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.5",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "eslint-plugin-security": "^4.0.1",
    "lucide-react": "^1.23.0",
    "next": "16.2.9",
    "next-auth": "5.0.0-beta.31",
    "radix-ui": "^1.6.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.81.0",
    "swr": "^2.4.2",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-table": "^7.7.20",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^3"
  },
  "packageManager": "pnpm@10.33.1"
}
