# =============================================================================
# Variables de entorno — Sistema de Consulta de Títulos del MEP
# =============================================================================
# Copia este archivo como .env.local y completa los valores.
# NUNCA committed .env.local — contiene secretos de producción.
# =============================================================================

# --- Desarrollo local ---
# Para desarrollo local con SQLite en vez de Turso, usa:
#   pnpm dev:local
# Esto crea/usa mep-actas-local.db automáticamente.
# En .env.local para desarrollo local, configura al menos:
#   NEXTAUTH_SECRET=clave-segura-aqui
#   TURSO_DATABASE_URL=file:./mep-actas-local.db
# (dev:local también fija la URL de la base; en .env.local evita fallos si usas pnpm dev)

# --- Turso (Base de datos) ---
# URL de conexión a la base de datos Turso (libSQL).
# Para SQLite local: file:./mep-actas-local.db (se usa automático con dev:local)
TURSO_DATABASE_URL=
# Token de autenticación de Turso (solo servidor, nunca al navegador).
TURSO_AUTH_TOKEN=

# --- NextAuth (Autenticación) ---
# Secreto para firmar los JWT. Genera uno con: openssl rand -base64 32
NEXTAUTH_SECRET=
# URL base de la aplicación en producción (ej. https://mep-actas.vercel.app).
NEXTAUTH_URL=

# --- Cloudflare R2 (Almacenamiento de escaneos) ---
# ID de la cuenta de Cloudflare R2.
R2_ACCOUNT_ID=
# Clave de acceso de la API de R2.
R2_ACCESS_KEY_ID=
# Clave secreta de la API de R2.
R2_SECRET_ACCESS_KEY=
# Nombre del bucket de R2 para los escaneos de folios.
R2_BUCKET=

# --- Rate Limiting (Opcional) ---
# Máximo de intentos de inicio de sesión por minuto por IP (default: 5).
LOGIN_RATE_LIMIT_MAX=5
